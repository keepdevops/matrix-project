# Copy to .env for local development (CRA reads REACT_APP_* at build time only).

# --- React (build time) ---
# API base. Dev: full URL to proxy. Production behind nginx same-origin: /api
# REACT_APP_API_BASE=http://localhost:3002/api
# REACT_APP_API_BASE=/api

# MLX coordinator (Python, port 3003). Dev (npm start) defaults to
# http://localhost:3003/api/mlx; production build defaults to /api/mlx (nginx).
# REACT_APP_MLX_API_BASE=/api/mlx

# --- Matrix proxy / coordinator (runtime: C++ proxy, Node proxy.mjs, coordinator) ---
# Model storage (GGUF files + HF-style model dirs with config.json)
# MATRIX_MODEL_DIR=/Users/Shared/llama/models

# llama-server / llama.cpp server binary
# MATRIX_LLAMA_SERVER=/Users/Shared/llama/llama-server

# Active swarm config written by CONFIGURE
# MATRIX_ACTIVE_CONFIG=/tmp/matrix-active-config.json

# KV slot path for llama-server --slot-save-path
# MATRIX_SLOTS_DIR=/tmp/matrix-slots

# Python for mlx_lm.server (full path)
# MATRIX_MLX_PYTHON=/path/to/miniforge3/envs/matrix-mlx/bin/python3

# Ports
# MATRIX_PROXY_PORT=3002
# MATRIX_COORDINATOR_PORT=8000

# Node proxy.mjs only: full coordinator URL
# MATRIX_COORDINATOR_URL=http://127.0.0.1:8000

# Optional swarm-config HTTP service (matrix_config_service). When set, coordinator
# loads config via GET and persists modes/presets via PUT (still uses --config for paths).
# MATRIX_SWARM_CONFIG_SERVICE=http://127.0.0.1:8011
# MATRIX_CONFIG_SERVICE_PORT=8011

# Coordinator: max approximate prompt tokens for pipeline/cascade/stream synthesis
# (concatenated stage/agent outputs). Default 1400 (~5600 chars); lower if the
# synthesizer llama-server uses --ctx-size 2048; raise after increasing context.
# MATRIX_SYNTHESIS_MAX_PROMPT_TOKENS=1400

# Suggested defaults for your machine — print with:
#   bash scripts/matrix-env.sh
#   source scripts/matrix-env.sh
